# Copy to .env only for local overrides. Never commit the resulting file.
COMPOSE_PROJECT_NAME=nostr-auth

# Immutable upstream provenance assertion for the vendored source.
POMEGRANATE_REF=ca0e7a9d697a7db0fc918f9b9335bc5b58d2ac3f

# Production central Compose inputs (configure as Coolify secrets, not a shared
# .env file). They become the exact upstream names inside the container.
CENTRAL_SERVICE_URL=https://auth.lapis.md
CENTRAL_GOOGLE_CLIENT_ID=
CENTRAL_GOOGLE_CLIENT_SECRET=
CENTRAL_GOOGLE_CLIENT_SECRET_FILE=
CENTRAL_SECRET_KEY=
CENTRAL_SECRET_KEY_FILE=

# Optional Lapis-operated production operator. Give this Coolify service its
# own environment/secret set even if Google uses the same OAuth application.
OPERATOR_SERVICE_URL=https://po.lapis.md
# Comma-separated exact central origins this operator will contact during registration.
OPERATOR_TRUSTED_CENTRAL_URLS=https://auth.lapis.md
OPERATOR_GOOGLE_CLIENT_ID=
OPERATOR_GOOGLE_CLIENT_SECRET=
OPERATOR_GOOGLE_CLIENT_SECRET_FILE=
