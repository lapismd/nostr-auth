FROM denoland/deno:alpine-2.9.6@sha256:aa665f8777136863b5b8a0445a5cdfccff8103b5f40c9a877de5276b04facb1e

USER root
RUN apk add --no-cache docker-cli=29.5.3-r0 docker-cli-compose=5.1.4-r0
WORKDIR /workspace
COPY deno.json deno.lock ./
COPY src ./src
COPY scripts ./scripts
COPY tests ./tests
COPY spec ./spec
COPY vendor ./vendor
COPY docker/log-filter.awk ./docker/log-filter.awk
COPY compose.yml compose.dev.yml compose.prod.yml ./
RUN deno cache --lock=deno.lock src/mod.ts scripts/*.ts tests/*.ts && \
    addgroup -g 65532 -S pomegranate && \
    adduser -u 65532 -S -D -H -G pomegranate pomegranate && \
    install -d -o 65532 -g 65532 -m 0700 /run/central-secrets /run/test-auth && \
    chown -R 65532:65532 /deno-dir /workspace

USER 65532:65532
ENTRYPOINT ["deno"]
CMD ["task", "check:all"]
