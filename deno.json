{
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "es2023"],
    "strict": true
  },
  "imports": {
    "@fiatjaf/promenade-trusted-dealer": "jsr:@fiatjaf/promenade-trusted-dealer@0.4.3",
    "@nostr/tools": "jsr:@nostr/tools@2.25.1",
    "@nostr/tools/nip46": "jsr:@nostr/tools@2.25.1/nip46",
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "exclude": [".tmp", "artifacts", "backups", "vendor"],
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "tasks": {
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check src/mod.ts scripts/*.ts tests/*.ts",
    "test": "deno test --allow-env --allow-read --allow-run --allow-write tests",
    "spec:check": "deno run --allow-read scripts/spec-check.ts",
    "vendor:check": "deno run --allow-read scripts/vendor-check.ts",
    "compose:check": "deno test --allow-env --allow-read --allow-run tests/compose.test.ts",
    "backup:check": "deno run --allow-read scripts/backup-check.ts",
    "smoke": "deno run --allow-env --allow-net --allow-read --allow-run scripts/smoke-test.ts",
    "check:all": "deno task fmt:check && deno task lint && deno task check && deno task spec:check && deno task vendor:check && deno task test",
    "generate:dev": "deno run --allow-read --allow-write scripts/generate-secrets.ts"
  }
}
